# ── Server Configuration ──────────────────────────────────────────────────
PORT=5000
NODE_ENV=production
COOKIE_DOMAIN=.litmuslabs.in

# ── MongoDB Database ───────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/litmus_production

# ── JWT Authentication Secrets (Use long random strings >= 32 characters) ─
JWT_ACCESS_SECRET=your_super_secret_access_token_key_here_min_32_chars
JWT_REFRESH_SECRET=your_super_secret_refresh_token_key_here_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── DigitalOcean Spaces / AWS S3 Object Storage ───────────────────────────
DO_SPACES_ENDPOINT=https://sgp1.digitaloceanspaces.com
DO_SPACES_KEY=your_spaces_access_key
DO_SPACES_SECRET=your_spaces_secret_key
DO_SPACES_NAME=litmuslabs
DO_SPACES_REGION=sgp1

# ── Razorpay Payment Gateway ──────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_live_key_secret
RAZORPAY_WEBHOOK_SECRET=your_live_webhook_secret

# ── SMTP Email (Brevo / Sendinblue / Custom SMTP) ─────────────────────────
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_smtp_login_email
SMTP_PASS=your_smtp_master_password
SMTP_FROM=noreply@litmuslabs.in

# ── WhatsApp Business Cloud API (Meta Graph API) ──────────────────────────
WHATSAPP_API_TOKEN=your_meta_system_user_permanent_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_waba_account_id
WHATSAPP_API_VERSION=v25.0
ADMIN_WHATSAPP_NUMBER=919876543210

# ── Frontend Applications CORS Whitelist ──────────────────────────────────
# Comma-separated list of all allowed origins
FRONTEND_URL=https://litmuslabs.in,https://admin.litmuslabs.in,https://lab.litmuslabs.in

# ── Redis Cache & Socket.IO Clustering (Optional) ─────────────────────────
# When using docker-compose.prod.yml, this is automatically set to redis://redis:6379
REDIS_URL=redis://localhost:6379
